# Copy this file to .env. .env is gitignored.

# How the Claude calls are made:
#   anthropic   - the API key below (billed per token; needs API credits)
#   claude_code - your Claude subscription through Claude Code (`claude -p`), no API credits
#   ollama      - a free local model through Ollama (run: ollama pull qwen3:8b)
LLM_BACKEND=anthropic
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_FAST_MODEL=

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional model overrides (defaults live in config.py and are verified at startup)
# FAST_MODEL=claude-haiku-5-5
# WRITE_MODEL=claude-sonnet-5-5
